{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterliloan",
  "compatibility_date": "2026-10-01",
  // Static assets only: no Worker script (no "main").
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
