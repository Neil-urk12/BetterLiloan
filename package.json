{
  "name": "bs-web",
  "version": "1.2.0",
  "description": "BetterLiloan.org - Official Portal for LGU Solano",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "version:major": "node scripts/bump-version.js major",
    "version:minor": "node scripts/bump-version.js minor",
    "version:patch": "node scripts/bump-version.js patch",
    "version:check": "node scripts/bump-version.js",
    "test": "playwright test",
    "test:chrome": "playwright test --project=chrome",
    "test:report": "playwright show-report",
    "lighthouse": "lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro build && wrangler dev",
    "test:content": "node --test tests/no-solano.test.mjs tests/localization-regressions.node.mjs"
  },
  "keywords": [
    "solano",
    "nueva-vizcaya",
    "government",
    "lgu"
  ],
  "author": "Ramon Logan Jr.",
  "license": "MIT",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "astro": "^7.4.4",
    "playwright": "^1.61.0",
    "prettier": "^3.8.1",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.14.0"
}
